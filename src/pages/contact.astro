---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import T from '../components/T.astro';
import { site, url } from '../data/site';
---
<Base title="상담 신청" description="매쓰게이트 상담 신청. 전화, 문자, 카카오톡으로 편하게 문의해 주세요.">
  <PageHead section="상담" title="상담 신청" lead="수업 중에는 전화를 받기 어려울 수 있어요. 문자를 남겨 주시면 수업이 끝난 뒤 바로 연락드립니다." />
  <div class="mx-auto max-w-5xl px-5 mt-16 grid gap-px bg-line border border-line md:grid-cols-3">
    <a href={`tel:${site.phone}`} class="bg-white p-8 hover:bg-paper">
      <p class="text-sm text-brand-500">전화</p>
      <p class="mt-2 text-2xl font-bold">{site.phone}</p>
      <p class="mt-3 text-ink/75 text-[15px]"><T text={site.hours} /></p>
    </a>
    <a href={`sms:${site.phone}`} class="bg-white p-8 hover:bg-paper">
      <p class="text-sm text-brand-500">문자</p>
      <p class="mt-2 text-2xl font-bold">문자 남기기</p>
      <p class="mt-3 text-ink/75 text-[15px]">학생 이름, 학년, 학교, 통화 가능한 시간을 적어 주세요.</p>
    </a>
    {site.kakao ? (
      <a href={site.kakao} class="bg-white p-8 hover:bg-paper">
        <p class="text-sm text-brand-500">카카오톡</p>
        <p class="mt-2 text-2xl font-bold">채널로 문의</p>
        <p class="mt-3 text-ink/75 text-[15px]">늦은 시간에도 남겨 두시면 다음 날 답변드립니다.</p>
      </a>
    ) : (
      <div class="bg-white p-8">
        <p class="text-sm text-brand-500">카카오톡</p>
        <p class="mt-2"><span class="todo">[TODO] src/data/site.ts 의 kakao 에 채널 주소를 넣으면 이 칸이 활성화됩니다</span></p>
      </div>
    )}
  </div>
  <p class="mx-auto max-w-5xl px-5 mt-8 text-ink/75">방문 상담은 미리 연락 주시면 시간을 맞춰 드립니다. <a href={url('about/location')} class="underline underline-offset-8 decoration-lilac-600 decoration-1">오시는 길</a></p>
</Base>
