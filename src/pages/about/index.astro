---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CallBand from '../../components/CallBand.astro';
import { career, greeting } from '../../data/director';
import { url } from '../../data/site';
---
<Base title="인사말 · 원장 약력" description="매쓰게이트 원장 인사말과 약력. 대치동 미래학원 입시전략실장, 압구정 연세학원 원장 등을 거쳐 2023년 파주 운정 해오름마을에 문을 열었습니다.">
  <PageHead section="학원 소개" title="인사말 · 원장 약력" />
  <div class="mx-auto max-w-[1200px] px-5 mt-16 grid gap-14 lg:grid-cols-[1fr_20rem]">
    <article class="prose-kr text-[17px] leading-[1.9] max-w-[38rem]">
      {greeting.map((p) => <p>{p}</p>)}
      <p class="mt-8 font-semibold">매쓰게이트 학원 드림</p>
      <p class="mt-10"><a href={url('about/philosophy')} class="font-semibold underline underline-offset-8 decoration-lilac-600 decoration-1 hover:text-lilac-600">매쓰게이트의 교육 철학 보기</a></p>
    </article>
    <aside>
      <!-- 원장 사진: 정식 프로필 사진을 받으면 넣습니다. director-temp.jpg는 임시 사진이라 쓰지 않습니다 -->
      <p class="text-sm"><span class="todo">[원장님 확인 필요] 정식 프로필 사진</span></p>
      <h2 class="text-brand-900 mt-8 font-bold">원장 약력</h2>
      <ul class="mt-3 border-t border-ink text-[15px]">
        {career.map((c) => (
          <li class="py-2.5 border-b border-line flex justify-between gap-3">
            <span class:list={[c.now && 'font-bold']}>{c.text}</span>
            <span class="text-brand-500 text-sm shrink-0">{c.now ? '현재' : '전'}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
  <CallBand />
</Base>
