---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CallBand from '../../components/CallBand.astro';
import { principles, column } from '../../data/philosophy';
---
<Base title="교육 철학" description="몰입의 질, 하루 25~35문제, 깊이 있는 선행, 틀려도 괜찮다는 안정감. 매쓰게이트가 수학을 가르치는 다섯 가지 원칙입니다.">
  <PageHead section="학원 소개" title="수학이 어려운 이유는 대부분 능력이 아니라 방식에 있습니다" lead="원장님이 오랫동안 학생들을 가르치며 정리한 다섯 가지 원칙입니다." />
  <div class="mx-auto max-w-4xl px-5 mt-16">
    <ul>
      {principles.map((p) => (
        <li class="grid md:grid-cols-[1fr_12rem] gap-4 md:gap-10 py-10 border-b border-line first:border-t first:border-ink">
          <div>
            <h2 class="text-brand-900 text-xl md:text-2xl font-bold tracking-[-0.02em]">{p.title}</h2>
            <p class="mt-3 text-ink/75 text-[17px] leading-[1.85]">{p.body}</p>
          </div>
          {p.note && <p class="text-sm font-medium text-lilac-600 md:pt-2 md:text-right">{p.note}</p>}
        </li>
      ))}
    </ul>

    <details class="mt-14 group border border-line">
      <summary class="cursor-pointer list-none px-6 py-5 flex justify-between items-center font-semibold hover:bg-paper">
        원장 칼럼 전문 읽기
        <span class="text-brand-500 text-sm group-open:hidden">펼치기</span>
        <span class="text-brand-500 text-sm hidden group-open:inline">접기</span>
      </summary>
      <div class="px-6 pb-8 pt-2 prose-kr text-[17px] leading-[1.9] max-w-[40rem]">
        {column.map((p) => <p>{p}</p>)}
      </div>
    </details>
  </div>
  <CallBand />
</Base>
