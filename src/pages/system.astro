---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CallBand from '../components/CallBand.astro';
import Rule from '../components/Rule.astro';
import SystemStory from '../components/SystemStory.astro';

// 한 달 주기 (기존 페이지 문구)
const cycle = [
  { when: '매주', name: '판서 강의 + 유형 분석 수업', body: '주 3회 중 2회는 현행 진도 강의, 1회는 유형 분석과 평가 수업으로 이해한 것을 바로 확인합니다.' },
  { when: '매월 마지막 주', name: '정기 평가', body: '한 달 동안 배운 단원으로 평가를 보고, 맞힌 문제보다 틀린 이유를 먼저 봅니다.' },
  { when: '평가 후', name: '학습 보고서 발송', body: '평가 결과와 학습 보고서를 휴대폰으로 보내 드립니다.' },
];
---
<Base title="관리 시스템" description="AI 진단, 실시간 학습 확인, 다각도 데이터 시각화, 24시간 학습 커뮤니케이션. 매쓰게이트의 학습 관리 방식입니다.">
  <PageHead section="관리 시스템" title="진단은 데이터로 정확하게, 처방은 오직 단 한 명의 학생에게 완벽하게." lead="수업, 평가, 보고가 한 달 주기로 돌아갑니다." />

  <SystemStory intro={false} />

  <section class="bg-brand-950 text-white">
    <div class="mx-auto max-w-[1200px] px-5 py-20 md:py-28">
      <div data-reveal>
        <p class="display-label text-sm text-lilac-300">Monthly Cycle</p>
        <h2 class="mt-4 text-2xl md:text-3xl font-bold tracking-[-0.02em]">한 달 주기</h2>
      </div>
      <ol data-reveal class="mt-10 grid md:grid-cols-3 border-t border-lilac-300/25">
        {cycle.map((c, i) => (
          <li class:list={['py-8 border-b border-lilac-300/25 md:border-b-0', i > 0 && 'md:border-l md:pl-8', i < cycle.length - 1 && 'md:pr-8']}>
            <p class="text-sm text-lilac-300">{c.when}</p>
            <h3 class="mt-2 text-xl font-semibold">{c.name}</h3>
            <p class="mt-3 text-white/70">{c.body}</p>
          </li>
        ))}
      </ol>

      <Rule dark class="mt-16" />

      <div data-reveal class="mt-14 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-xl md:text-2xl font-bold">선행 대신 심화 연계</h2>
          <p class="mt-3 text-[17px] leading-[1.85] text-white/70">각 학년마다 다음 학기 과정을 진도만 빼는 선행이 아니라, 지금 배우는 내용과 이어지는 심화 연계 학습으로 진행합니다.</p>
        </div>
        <div>
          <h2 class="text-xl md:text-2xl font-bold">학생마다 다른 속도</h2>
          <p class="mt-3 text-[17px] leading-[1.85] text-white/70">고3과 특목고 학생은 진도, 수업 시간, 난이도를 학생마다 따로 정합니다.</p>
        </div>
      </div>
      <!-- [TODO] 출결 알림, 숙제 관리, 보강 정책 등 실제로 하고 있는 관리가 있다면 여기에 추가하세요 -->
    </div>
  </section>
  <CallBand />
</Base>
