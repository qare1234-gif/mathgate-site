---
// 하위 페이지 상단: brand-950 바탕 위에 위치 표시, 제목, 설명
import Hex from './Hex.astro';
interface Props { section?: string; title: string; lead?: string; }
const { section, title, lead } = Astro.props;
---
<section class="relative overflow-hidden bg-brand-950 text-white">
  <Hex class="pointer-events-none absolute -right-24 -bottom-48 w-[26rem] text-lilac-300 opacity-15" />
  <div class="relative mx-auto max-w-[1200px] px-5 pt-16 pb-16 md:pt-20 md:pb-20">
    {section && <p class="rise text-sm font-medium text-lilac-300">{section}</p>}
    <h1 class="rise rise-2 mt-3 max-w-3xl text-3xl md:text-[2.75rem] font-bold tracking-[-0.02em] leading-[1.3]">{title}</h1>
    {lead && <p class="rise rise-3 mt-5 max-w-2xl text-lg text-white/75"><slot name="lead">{lead}</slot></p>}
  </div>
</section>
