---
// 관리 시스템 (DESIGN_BRIEF.md 7절 '관리 시스템'). paper ↔ brand-950이 번갈아 나오는 긴 섹션.
// photos/system/ 이미지는 각 이미지 배경과 같은 색 면(panel-*, white) 위에 올려 경계를 없앤다.
// 이미지 위 그림자·둥근 모서리 금지. 제목·설명은 이미지가 아니라 HTML 텍스트로.
import Hex from './Hex.astro';
import Kicker from './Kicker.astro';
import { url } from '../data/site';

interface Props { intro?: boolean }
const { intro = true } = Astro.props;

const img = (name: string) => url(`images/mathgate/photos/${name}`);
const pad = (i: number) => String(i + 1).padStart(2, '0');

const diagnosis = [
  { name: '교재채점 데이터', body: '수업별 정오답 · 풀이 패턴 실시간 수집' },
  { name: 'AI 유형분석', body: '취약유형 · 오답 패턴 · 이해도 측정' },
  { name: '진단 · 평가 결과', body: '단원평가 · 성취도평가 · 일일테스트' },
];

const communication = [
  { name: '매일 확인', body: '수업 직후 카카오톡으로 당일 학습량·오답·내일 예고까지 전달합니다.', src: 'system/daily-check-phone.png', w: 290, h: 385, alt: '휴대폰 화면의 일일 학습 리포트' },
  { name: '요약 리포트', body: '문제풀이 학습량, 수업성과지표, 성적 추이, 목표대비 달성률, 취약 유형을 담습니다.', src: 'system/summary-report.png', w: 290, h: 400, alt: '종합 학습 분석 요약 리포트 한 장' },
  { name: '종합 보고서', body: '월간 학습내용과 평가로 강점·약점을 분석하고, 레벨 성장 지표와 다음 달 맞춤 처방까지 드립니다.', src: 'system/comprehensive-report.png', w: 435, h: 400, alt: '종합평가, 예상 백분위, 행동영역 분석이 담긴 종합 보고서 페이지들' },
];
---
{intro && (
  <!-- 1. 도입 -->
  <section class="relative overflow-hidden bg-brand-950 text-white">
    <Hex class="pointer-events-none absolute -left-28 -bottom-44 w-[30rem] text-lilac-300 opacity-15" />
    <div data-reveal class="relative mx-auto max-w-[1200px] px-5 py-24 md:py-32">
      <Kicker no="03" label="System" dark />
      <h2 class="mt-6 max-w-4xl text-3xl md:text-5xl leading-[1.3] md:leading-[1.25] font-bold tracking-[-0.02em]">
        진단은 데이터로 정확하게,<br />
        처방은 오직 단 한 명의 학생에게 완벽하게.
      </h2>
      <a href={url('system')} class="inline-block mt-10 font-semibold underline underline-offset-8 decoration-1 decoration-lilac-300 hover:text-lilac-300 transition-colors">관리 시스템 페이지로</a>
    </div>
  </section>
)}

<!-- 2. 전체 학습 플로우: 데스크톱은 컨테이너 전체 폭 + 클릭 시 원본 크기, 모바일은 가로 스크롤 -->
<section class="mx-auto max-w-[1200px] px-5 py-24 md:py-28">
  <div data-reveal class="grid gap-6 lg:grid-cols-[5fr_7fr] lg:gap-20 items-end">
    <div>
      <p class="display-label text-sm text-lilac-600">Learning Flow</p>
      <h3 class="mt-4 text-2xl md:text-3xl font-bold tracking-[-0.02em] text-brand-900">전체 학습 플로우</h3>
    </div>
    <p class="text-brand-500 max-w-xl">어떤 학생이 와도 철저하게 현재 학습현황을 면밀히 진단하고 시작합니다. 진단부터 수업, 시험대비, 학습관리, 평가까지 한 흐름으로 이어집니다.</p>
  </div>
  <div data-reveal class="mt-12">
    <p class="lg:hidden mb-3 text-sm text-brand-500" aria-hidden="true">← 좌우로 밀어서 보기 →</p>
    <div class="overflow-x-auto bg-panel-flow">
      <a href={img('system/full-learning-flow.jpg')} data-lightbox class="block min-w-[960px] lg:min-w-0 overflow-hidden cursor-zoom-in" aria-label="전체 학습 플로우 원본 크기로 보기">
        <!-- 원본 맨 위 흰 줄(약 12px)을 가리려고 음수 margin -->
        <img src={img('system/full-learning-flow.jpg')} alt="학습 플로우: AI학습현황, AI맞춤진단, 수업, 시험대비, 학습관리, 평가로 이어지는 흐름과 단계별 세부 내용" width="2400" height="1248" loading="lazy" class="w-full h-auto -mt-[0.55%]" />
      </a>
    </div>
    <p class="hidden lg:block mt-3 text-sm text-brand-500">이미지를 누르면 원본 크기로 볼 수 있습니다.</p>
  </div>
</section>

<!-- 3. AI 진단 -->
<section class="bg-brand-950 text-white">
  <div class="mx-auto max-w-[1200px] px-5 py-24 md:py-28 grid gap-14 lg:grid-cols-[5fr_7fr] lg:gap-16 items-center">
    <div data-reveal>
      <p class="display-label text-sm text-lilac-300">AI Diagnosis</p>
      <h3 class="mt-4 text-2xl md:text-3xl font-bold tracking-[-0.02em]">AI 진단</h3>
      <ol class="mt-8 border-t border-lilac-300/25">
        {diagnosis.map((d, i) => (
          <li class="grid grid-cols-[3rem_1fr] py-5 border-b border-lilac-300/25">
            <span class="font-display text-lg text-lilac-300">{pad(i)}</span>
            <div>
              <p class="font-semibold">{d.name}</p>
              <p class="mt-1 text-[15px] text-white/65">{d.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-10">
        <p class="leading-none"><span class="font-display text-7xl md:text-8xl tracking-[0.02em]">38</span><span class="ml-2 text-3xl md:text-4xl font-bold">억 건</span></p>
        <p class="mt-4 text-white/75">누적 빅데이터 <span class="text-white/45">(매쓰홀릭 문항 / 개념 DB 연동)</span></p>
        <p class="mt-6 text-lg font-semibold"><span class="text-lilac-300" aria-hidden="true">→ </span>학생별 1:1 진단</p>
      </div>
    </div>
    <div data-reveal class="bg-white p-4 md:p-6">
      <img src={img('system/ai-diagnosis-data.png')} alt="학습 데이터 수집부터 AI 기반 정밀 진단, 학생 A~D별 문항 구성과 정답률까지 이어지는 AI 진단 화면" width="1127" height="586" loading="lazy" class="w-full h-auto" />
    </div>
  </div>
</section>

<!-- 4. 왜 틀렸는지 -->
<section class="mx-auto max-w-[1200px] px-5 py-24 md:py-28">
  <div data-reveal class="grid gap-6 lg:grid-cols-[7fr_5fr] lg:gap-16 items-end">
    <h3 class="text-3xl md:text-[2.5rem] leading-[1.3] font-bold tracking-[-0.02em] text-brand-900">“점수만 보면 ‘왜 틀렸는지’를 모릅니다.”</h3>
    <p class="text-lg text-brand-500">풀이과정을 꼼꼼히 분석하여 개념 부족인지 문제해석 오류인지 정확히 파악하고 전달합니다.</p>
  </div>
  <div data-reveal class="mt-12 bg-panel-lilac p-3 md:p-6">
    <img src={img('system/why-wrong-ui.png')} alt="학생별 문항 채점 현황표와 학생이 손으로 쓴 풀이가 보이는 강의모드 화면" width="1085" height="360" loading="lazy" class="w-full h-auto" />
  </div>
</section>

<!-- 5. 선생님 실시간 확인 -->
<section class="bg-brand-950 text-white">
  <div class="mx-auto max-w-[1200px] px-5 py-24 md:py-28">
    <div data-reveal class="grid gap-6 lg:grid-cols-[7fr_5fr] lg:gap-16 items-end">
      <h3 class="text-3xl md:text-[2.5rem] leading-[1.3] font-bold tracking-[-0.02em]">“선생님이 놓칠 틈이 없어요.”</h3>
      <p class="text-lg text-white/75">실시간으로 확인하면서 우리 반 학생에 대한 문제풀이와 학습과정을 면밀히 살펴봅니다.</p>
    </div>
    <div data-reveal class="mt-12 bg-white p-3 md:p-6">
      <img src={img('system/teacher-realtime-ui.png')} alt="반 학생들의 날짜별 학습 이력, 학습 코멘트, 학생 풀이노트 화면" width="1310" height="570" loading="lazy" class="w-full h-auto" />
    </div>
  </div>
</section>

<!-- 6. 다각도 데이터 시각화 -->
<section class="mx-auto max-w-[1200px] px-5 py-24 md:py-28">
  <div data-reveal class="grid gap-6 lg:grid-cols-[7fr_5fr] lg:gap-16 items-end">
    <div>
      <p class="display-label text-sm text-lilac-600">Data Visualization</p>
      <h3 class="mt-4 text-2xl md:text-3xl font-bold tracking-[-0.02em] text-brand-900">다각도 데이터 시각화</h3>
    </div>
    <ul class="flex flex-wrap lg:justify-end gap-x-6 gap-y-2 font-semibold text-brand-900">
      <li>점수로 확인</li>
      <li class="pl-6 border-l border-line">색깔로 확인</li>
      <li class="pl-6 border-l border-line">코멘트로 확인</li>
    </ul>
  </div>
  <div data-reveal class="mt-12 bg-white p-3 md:p-6">
    <img src={img('system/data-visualization-cards.png')} alt="목표 정답 문제 수에 따른 예상 백분위, 유형별 학습 현황, 학습 코멘트 카드" width="1335" height="430" loading="lazy" class="w-full h-auto" />
  </div>
</section>

<!-- 7. 24시간 학습 커뮤니케이션: 3단계를 각각 이미지와 짝지어 배치 -->
<section class="relative overflow-hidden bg-brand-950 text-white">
  <Hex class="pointer-events-none absolute -right-32 -top-28 w-[32rem] text-lilac-300 opacity-15" />
  <div class="relative mx-auto max-w-[1200px] px-5 py-24 md:py-28">
    <div data-reveal>
      <p class="display-label text-sm text-lilac-300">24H Communication</p>
      <h3 class="mt-4 text-2xl md:text-3xl font-bold tracking-[-0.02em]">24시간 학습 커뮤니케이션</h3>
    </div>
    <ol class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
      {communication.map((c, i) => (
        <li data-reveal class="flex flex-col">
          <div class="bg-panel-lilac aspect-[4/3] p-6 overflow-hidden">
            <img src={img(c.src)} alt={c.alt} width={c.w} height={c.h} loading="lazy" class="w-full h-full object-contain" />
          </div>
          <div class="mt-6 grid grid-cols-[3rem_1fr] border-t border-lilac-300/25 pt-5">
            <span class="font-display text-2xl text-lilac-300 leading-none pt-0.5">{pad(i)}</span>
            <div>
              <h4 class="text-lg font-semibold">{c.name}</h4>
              <p class="mt-2 text-[15px] leading-[1.7] text-white/70">{c.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 실물 보고서 사진 -->
<section class="mx-auto max-w-[1200px] px-5 py-24 md:py-28">
  <div data-reveal class="grid gap-6 lg:grid-cols-[5fr_7fr] lg:gap-20 items-end">
    <div>
      <p class="display-label text-sm text-lilac-600">Printed Report</p>
      <h3 class="mt-4 text-2xl md:text-3xl font-bold tracking-[-0.02em] text-brand-900">실제로 받아보는 보고서</h3>
    </div>
    <p class="text-brand-500">학부모님이 실제로 받아보시는 종합학습보고서입니다. (학생 이름은 가렸습니다)</p>
  </div>
  <div data-reveal class="mt-12 grid gap-6 sm:grid-cols-2">
    <img src={img('report-comprehensive.jpg')} alt="2월 종합학습보고서 표지 여러 장" width="1432" height="976" loading="lazy" class="hex-cut w-full aspect-[4/3] object-cover" />
    <img src={img('report-learning.jpg')} alt="진단 보고서와 종합학습보고서 표지" width="1440" height="1080" loading="lazy" class="w-full aspect-[4/3] object-cover" />
  </div>
</section>

<dialog id="lightbox" class="lightbox" aria-label="이미지 원본 보기">
  <div class="h-full w-full overflow-auto">
    <form method="dialog" class="sticky top-0 flex justify-end p-4">
      <button class="h-10 px-4 border border-lilac-300 text-white text-sm font-semibold hover:bg-lilac-300 hover:text-brand-950 transition-colors">닫기</button>
    </form>
    <img id="lightbox-img" alt="" class="block mx-auto max-w-none px-4 pb-8" />
  </div>
</dialog>

<script>
  // [data-lightbox] 링크를 누르면 원본 크기로. JS가 없으면 링크가 이미지를 그대로 엽니다.
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const big = document.getElementById('lightbox-img') as HTMLImageElement | null;
  document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (!dialog || !big || !dialog.showModal) return;
      e.preventDefault();
      big.src = a.href;
      big.alt = a.querySelector('img')?.alt ?? '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (e) => { if (e.target === dialog || e.target === dialog.firstElementChild) dialog.close(); });
</script>
