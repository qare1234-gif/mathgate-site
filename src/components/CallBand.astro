---
import Rule from './Rule.astro';
import { site, url } from '../data/site';
---
<section class="mx-auto max-w-[1200px] px-5 py-20 md:py-24">
  <Rule />
  <div data-reveal class="mt-12 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="display-label text-sm text-lilac-600">Contact</p>
      <h2 class="mt-4 text-2xl md:text-3xl font-bold tracking-[-0.02em] text-brand-900">궁금한 것부터 편하게 물어보세요.</h2>
      <p class="mt-3 max-w-xl text-ink/75">학생의 지금 진도와 고민을 듣고, 맞는 과정을 안내해 드립니다.</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href={url('contact')} class="inline-flex items-center h-12 px-7 bg-brand-900 text-white font-semibold hover:bg-brand-950 transition-colors">상담 신청</a>
      <a href={`tel:${site.phone}`} class="font-display text-xl tracking-[0.08em] text-brand-900 underline-offset-8 decoration-1 decoration-lilac-600 hover:underline">{site.phone}</a>
    </div>
  </div>
</section>
